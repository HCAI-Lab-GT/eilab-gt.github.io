# Preconfigured Sites@GeorgiaTech staging site. No trailing slash.
WP_URL=https://sites.gatech.edu/hcailab

# Existing Jekyll repository root when commands run from migration/.
SOURCE_ROOT=..

# Optional WordPress REST credentials.
# Leave BOTH blank for public, read-only discovery.
# After creating a WordPress Application Password, set both values locally.
WP_USER=
WP_APP_PASSWORD=

# Default mutation controls. Generated/migrated pages remain drafts.
WP_STATUS=draft
DRY_RUN=1
APPLY=0

# Browser automation. Discovery determines the exact approved GT theme name.
GT_THEME_NAME=
PLAYWRIGHT_HEADLESS=0

# Safe defaults for browser configuration.
SITE_TITLE=Human-Centered AI Lab
SITE_TAGLINE=Georgia Institute of Technology
IMPORT_WXR=0
